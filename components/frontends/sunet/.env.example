HOST='0.0.0.0'
PORT=3000
VITE_WS_URL=ws://backend.localhost
VITE_WALLET_BACKEND_URL=http://backend.localhost
VITE_LOGIN_WITH_PASSWORD=false
VITE_DID_KEY_VERSION=jwk_jcs-pub
VITE_APP_VERSION=$npm_package_version
VITE_GENERATE_SOURCEMAP=true
VITE_DISPLAY_CONSOLE=true
VITE_WEBAUTHN_RPID=wallet.localhost
VITE_OPENID4VCI_REDIRECT_URI=http://wallet.localhost/
VITE_OPENID4VCI_PROOF_TYPE_PRECEDENCE="jpt,attestation,jwt"
VITE_OPENID4VP_SAN_DNS_CHECK=false
VITE_OPENID4VP_SAN_DNS_CHECK_SSL_CERTS=false
VITE_VALIDATE_CREDENTIALS_WITH_TRUST_ANCHORS=true
VITE_MULTI_LANGUAGE_DISPLAY=true
VITE_STATIC_PUBLIC_URL=http://wallet.localhost/
VITE_STATIC_NAME=wwWallet
VITE_FOLD_EVENT_HISTORY_AFTER_SECONDS=2592000
VITE_DISPLAY_ISSUANCE_WARNINGS=false
VITE_OPENID4VCI_MAX_ACCEPTED_BATCH_SIZE=10
VITE_OPENID4VCI_TRANSACTION_ID_POLLING_INTERVAL_IN_SECONDS=5
VITE_OPENID4VCI_TRANSACTION_ID_LIFETIME_IN_SECONDS=2592000
VITE_WELLKNOWN_APPLE_APPIDS=""
VITE_WELLKNOWN_ANDROID_PACKAGE_NAMES_AND_FINGERPRINTS=""
VITE_OHTTP_KEY_CONFIG=http://localhost:4567/ohttp-keys
VITE_OHTTP_RELAY=http://localhost:4001/api/relay