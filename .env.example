#WALLET_SERVER_JWT_REFRESH_DAYS=7
#WALLET_SERVER_JWT_ISSUER=go-wallet-backend
WALLET_SERVER_ADMIN_TOKEN=change-me-NOW
###

###
# WWWALLET CORE
WALLET_CORE_URL=${WALLET_CADDY_PROTOCOL}://${WALLET_CADDY_CORE_FQDN}
WALLET_CORE_DATABASE=wallet
WALLET_CORE_USER=wallet
WALLET_CORE_PASSWORD=wallet
