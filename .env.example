###
# CADDY
WALLET_CADDY_PROTOCOL=http
WALLET_CADDY_FRONTEND_FQDN=wallet.localhost
WALLET_CADDY_BACKEND_FQDN=backend.localhost
WALLET_CADDY_ISSUER_FQDN=issuer.localhost
WALLET_CADDY_VERIFIER_FQDN=verifier.localhost
WALLET_CADDY_GOBACKEND_FQDN=gobackend.localhost
WALLET_CADDY_CORE_FQDN=core.localhost
###

###
# WWWALLET GLOBAL
#WALLET_TAG=v0.4.0
#WALLET_FRONTEND_TAG=${WALLET_TAG}
#WALLET_BACKEND_TAG=${WALLET_TAG}
#WALLET_ISSUER_TAG=${WALLET_TAG}
#WALLET_VERIFIER_TAG=${WALLET_TAG}
###

###
# WWWALLET FRONTEND
WALLET_FRONTEND_URL=${WALLET_CADDY_PROTOCOL}${WALLET_CADDY_FRONTEND_FQDN}
# WALLET_FRONTEND_BUILD_CONTEXT=/root/wallet-docker-context/wallet-frontend
# WALLET_FRONTEND_BUILD_DOCKERFILE=Dockerfile
###

###
# WWWALLET BACKEND
WALLET_BACKEND_URL=${WALLET_CADDY_PROTOCOL}://${WALLET_CADDY_BACKEND_FQDN}
WALLET_BACKEND_DATABASE=wallet
WALLET_BACKEND_USER=wallet
WALLET_BACKEND_PASSWORD=wallet
# WALLET_BACKEND_BUILD_CONTEXT=/root/wallet-docker-context/wallet-backend-server
# WALLET_BACKEND_BUILD_DOCKERFILE=Dockerfile
WALLET_BACKEND_TRUSTED_
###

###
# WWWALLET VERIFIER
WALLET_VERIFIER_URL=${WALLET_CADDY_PROTOCOL}://${WALLET_CADDY_VERIFIER_FQDN}
WALLET_VERIFIER_DATABASE=verifier
WALLET_VERIFIER_USER=wallet
WALLET_VERIFIER_PASSWORD=wallet
# WALLET_VERIFIER_BUILD_CONTEXT=/root/wallet-docker-context
# WALLET_VERIFIER_BUILD_DOCKERFILE=docker/wallet-enterprise-verifier.Dockerfile
###

###
# WWWALLET ISSUER
WALLET_ISSUER_URL=${WALLET_CADDY_PROTOCOL}://${WALLET_CADDY_ISSUER_FQDN}
WALLET_ISSUER_DATABASE=issuer
WALLET_ISSUER_USER=wallet
WALLET_ISSUER_PASSWORD=wallet
# WALLET_ISSUER_BUILD_CONTEXT=/root/wallet-docker-context
# WALLET_ISSUER_BUILD_DOCKERFILE=docker/wallet-enterprise-issuer.Dockerfile
###

###
# WWWALLET GO BACKEND
WALLET_SERVER_RP_ID=${WALLET_CADDY_FRONTEND_FQDN}
WALLET_SERVER_RP_ORIGIN=${WALLET_CADDY_PROTOCOL}://${WALLET_CADDY_FRONTEND_FQDN}
WALLET_SERVER_RP_NAME=Go Wallet Backend
WALLET_SERVER_BASE_URL=${WALLET_CADDY_PROTOCOL}://${WALLET_CADDY_GOBACKEND_FQDN}
#WALLET_SERVER_STORAGE_TYPE=sqlite
#WALLET_SERVER_STORAGE_SQLITE_PATH=wallet.db
